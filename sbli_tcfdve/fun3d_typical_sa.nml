&version_number
    input_version = 2.2
/

&project
    project_rootname = 'cone_16_v8b_final_4_3D_fine'
    case_title       = "16deg Cone Axi - Fine Grid"
/

&raw_grid
    grid_format = "aflr3"
    data_format = "default"
/

&governing_equations
    eqn_type      = "compressible"
    viscous_terms = "turbulent"
    use_edge_gradients = .true.
/

&reference_physical_properties
    dim_input_type    = "nondimensional"
    temperature_units = "Kelvin"
    temperature       = 138.2
    angle_of_attack   = 0.0
    angle_of_yaw      = 0.0
    reynolds_number   = 23741972.63 !per m
    mach_number       = 2.5
/

&inviscid_flux_method
    flux_limiter             = "minmod"
    flux_construction        = "roe"
!    freeze_limiter_iteration = 4000
!    first_order_iterations   = 4000
/

&turbulent_diffusion_models
    turbulence_model = "sa"
!    turbulence_model = "sst-v"
/

&flow_initialization
    number_of_volumes = 3

!-- Plenum ---------------------------
    type_of_volume(1) = 'cylinder'
    point1(1:3,1)     = -2.0 0.0 0.0
    point2(1:3,1)     = -0.6446163 0.0 0.0
    radius(1)         =  0.2
    rho(1)            =  5.0
    u(1)              =  0.4
    c(1)              =  2.0

!-- Upstream Nozzle ------------------
    type_of_volume(2) = 'cylinder'
    point1(1:3,2)     = -0.6446163 0.0 0.0
    point2(1:3,2)     = -0.4519230 0.0 0.0
    radius(2)         =  0.2
    rho(2)            =  5.0
    u(2)              =  1.2
    c(2)              =  2.0

!-- Downstream Nozzle ----------------
    type_of_volume(3) = 'cylinder'
    point1(1:3,3)     = -0.4519230 0.0 0.0
    point2(1:3,3)     = -0.0604163 0.0 0.0
    radius(3)         =  0.2
    rho(3)            =  5.0
    u(3)              =  3.5
    c(3)              =  2.0
/

&nonlinear_solver_parameters
    time_accuracy = "steady"
    schedule_iteration = 1 1000
    schedule_cfl = 1.0 2.0
    schedule_cflturb = 1.0 2.0
/

&linear_solver_parameters
    meanflow_sweeps = 15
    turbulence_sweeps = 10
/

&boundary_conditions
    grid_units = "m"

!-- Inflow ---------------------------------
    total_pressure_ratio(5)    = 17.0859375
    total_temperature_ratio(5) =  2.25

!-- Outflow --------------------------------
    static_pressure_ratio(6) = 1.0

!-- Cone -----------------------------------
!   sets adiabatic wall condition 
    wall_temperature(3) = -1
    wall_temp_flag(3) = .true.

!-- Cylinder -------------------------------
!   sets adiabatic wall condition 
    wall_temperature(4) = -1
    wall_temp_flag(4) = .true.

!-- Wall -----------------------------------
!   sets adiabatic wall condition
    wall_temperature(7) = -1
    wall_temp_flag(7) = .true.
/

&global
    boundary_animation_freq = -1
!    volume_animation_freq   = -1
/

&boundary_output_variables
    number_of_boundaries = -1 ! compute from list
    boundary_list = "1-8"
    mach        = .true.
    ptot        = .true.
    ttot        = .true.
    temperature = .true.
    mu_t        = .true.
    yplus       = .true.
    turb1       = .true.
/

!&volume_output_variables
    mach        = .true.
    ptot        = .true.
    ttot        = .true.
    temperature = .true.
    turb1       = .true.
/

&code_run_control
    steps = 600000
    stopping_tolerance = 1.0E-15
    restart_write_freq = 1000
    restart_read = "off"
/
